generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Sala {
  id        Int       @id @default(autoincrement())
  nombre    String
  edificio  String
  capacidad Int
  reservas  Reserva[]      // una sala → muchas reservas
}

model Reserva {
  id          Int      @id @default(autoincrement())
  responsable String
  motivo      String
  inicio      DateTime
  fin         DateTime
  sala        Sala     @relation(fields: [salaId], references: [id], onDelete: Cascade)
  salaId      Int            // la llave foránea
}